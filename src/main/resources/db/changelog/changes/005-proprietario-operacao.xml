<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="005-proprietario-operacao" author="codex">
        <!-- Legado permanece privado e invisível até atribuição explícita do proprietário. -->
        <addColumn tableName="operacao_acao"><column name="usuario_id" type="BIGINT"/></addColumn>
        <addForeignKeyConstraint baseTableName="operacao_acao" baseColumnNames="usuario_id"
                                 referencedTableName="usuario" referencedColumnNames="id"
                                 constraintName="fk_operacao_usuario"/>
        <createIndex tableName="operacao_acao" indexName="idx_operacao_usuario_acao">
            <column name="usuario_id"/><column name="acao_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="operacao_acao" indexName="idx_operacao_usuario_acao"/>
            <dropForeignKeyConstraint baseTableName="operacao_acao" constraintName="fk_operacao_usuario"/>
            <dropColumn tableName="operacao_acao" columnName="usuario_id"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
